<div id="section-{{ section.id }}" class="combined-cards-section" style="background-color: {{ section.settings.page_bg_color }};">
  <div class="combined-cards-container">
    
    <!-- ==========================================
         LEFT CARD: BLACK (Product Details)
    =========================================== -->
    <div class="pd-card" id="pd-card-{{ section.id }}">
      <div class="pd-header">
        <div class="pd-title-group">
          <!-- Icon -->
          <svg class="pd-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="7" y="5" width="10" height="14" rx="2"></rect>
            <path d="M9 5v-1a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1"></path>
          </svg>
          <h2 class="pd-title">{{ section.settings.details_heading }}</h2>
        </div>
        <!-- Close Button -->
        <button class="pd-close-btn" aria-label="Close" onclick="document.getElementById('pd-card-{{ section.id }}').style.display='none'">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="pd-content-grid">
        {% for block in section.blocks %}
          {% if block.type == 'details_list' %}
            <div class="pd-block" {{ block.shopify_attributes }}>
              <h3 class="pd-block-heading">{{ block.settings.block_heading }}</h3>
              <div class="pd-list">
                {{ block.settings.block_content }}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- ==========================================
         RIGHT CARD: WHITE (What's Included)
    =========================================== -->
    <div class="wi-card">
      <div class="hanger-tab" aria-hidden="true">
        <svg class="icon-box" viewBox="0 0 234 74" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="0" y="0" width="234" height="74" fill="currentColor"></rect>
          <rect x="58" y="32" width="118" height="19" class="svg-cutout"></rect>
          <circle cx="117.5" cy="32.5" r="11.5" class="svg-cutout"></circle>
        </svg>
      </div>

      {% if section.settings.includes_heading != blank %}
        <h2 class="wi-heading">{{ section.settings.includes_heading }}</h2>
      {% endif %}

      <div class="wi-grid">
        {% for block in section.blocks %}
          {% if block.type == 'included_item' %}
            <div class="wi-item" {{ block.shopify_attributes }}>
              <div class="wi-image-circle">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 200, height: 200, crop: 'center' | image_tag: loading: 'lazy', alt: block.settings.title }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
              {% if block.settings.title != blank %}
                <p class="wi-title">{{ block.settings.title }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  </div>
</div>

<style>
  /* Section Container */
  #section-{{ section.id }}.combined-cards-section {
    padding: 80px 20px;
    display: flex;
    justify-content: center;
    font-family: var(--font-body--family, inherit);
  }

  #section-{{ section.id }} .combined-cards-container {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    justify-content: center;
    align-items: stretch; /* Makes both cards equal height if needed */
    max-width: 1400px;
    width: 100%;
  }

  /* ==========================================
     LEFT CARD STYLES (Black)
  =========================================== */
  #section-{{ section.id }} .pd-card {
    background-color: #1a1a1a;
    border-radius: 20px;
    padding: 30px 40px 40px;
    flex: 1;
    min-width: 300px;
    max-width: 600px;
    color: #ffffff;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }

  #section-{{ section.id }} .pd-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.15);
    padding-bottom: 20px;
    margin-bottom: 30px;
  }

  #section-{{ section.id }} .pd-title-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #section-{{ section.id }} .pd-icon {
    width: 22px;
    height: 22px;
    color: #ffffff;
  }

  #section-{{ section.id }} .pd-title {
    font-size: 20px;
    font-weight: 600;
    margin: 0;
    color: #ffffff;
    font-family: var(--font-heading--family, inherit);
  }

  #section-{{ section.id }} .pd-close-btn {
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 5px;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  #section-{{ section.id }} .pd-close-btn:hover { opacity: 1; }
  #section-{{ section.id }} .pd-close-btn svg { width: 20px; height: 20px; }

  #section-{{ section.id }} .pd-content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  #section-{{ section.id }} .pd-block-heading {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 12px;
    margin-top: 0;
    color: #ffffff;
    font-family: var(--font-heading--family, inherit);
  }

  #section-{{ section.id }} .pd-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #section-{{ section.id }} .pd-list li {
    position: relative;
    padding-left: 18px;
    margin-bottom: 8px;
    font-size: 14px;
    line-height: 1.5;
    color: #cccccc;
  }

  #section-{{ section.id }} .pd-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 5px;
    height: 5px;
    background-color: #888;
    border-radius: 50%;
  }

  /* ==========================================
     RIGHT CARD STYLES (White)
  =========================================== */
  #section-{{ section.id }} .wi-card {
    background-color: #f8f8f8;
    border-radius: 20px;
    padding: 60px 40px 50px;
    position: relative;
    flex: 1;
    min-width: 300px;
    max-width: 700px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    margin-top: 24px; /* Offset for hanger tab */
  }

  #section-{{ section.id }} .hanger-tab {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    width: 140px;
    color: #1a1a1a;
  }

  #section-{{ section.id }} .hanger-tab svg {
    width: 100%;
    height: auto;
    display: block;
  }

  #section-{{ section.id }} .svg-cutout {
    fill: {{ section.settings.page_bg_color }};
  }

  #section-{{ section.id }} .wi-heading {
    font-size: 32px;
    font-weight: 700;
    color: #111;
    margin-bottom: 40px;
    font-family: var(--font-heading--family, inherit);
    margin-top: 0;
  }

  #section-{{ section.id }} .wi-grid {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px;
  }

  #section-{{ section.id }} .wi-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 120px;
  }

  #section-{{ section.id }} .wi-image-circle {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background-color: #efefef;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 15px;
    overflow: hidden;
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.05);
  }

  #section-{{ section.id }} .wi-image-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
    display: block;
  }

  #section-{{ section.id }} .wi-image-circle .placeholder-svg {
    width: 50%;
    height: 50%;
    fill: #ccc;
  }

  #section-{{ section.id }} .wi-title {
    font-size: 15px;
    font-weight: 500;
    color: #333;
    margin: 0;
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 990px) {
    #section-{{ section.id }} .combined-cards-container {
      flex-direction: column;
      align-items: center;
      gap: 60px; /* More space when stacked vertically */
    }
    #section-{{ section.id }} .pd-card,
    #section-{{ section.id }} .wi-card {
      width: 100%;
      max-width: 100%;
    }
  }

  @media screen and (max-width: 600px) {
    #section-{{ section.id }} .pd-content-grid {
      grid-template-columns: 1fr; /* 1 column on mobile for black card */
      gap: 20px;
    }
    #section-{{ section.id }} .wi-grid {
      gap: 15px;
    }
    #section-{{ section.id }} .wi-item {
      width: 45%;
    }
    #section-{{ section.id }} .wi-image-circle {
      width: 90px;
      height: 90px;
    }
  }
</style>

{% schema %}
{
  "name": "Product Details",
  "tag": "section",
  "class": "section-details-includes",
  "settings": [
    {
      "type": "color",
      "id": "page_bg_color",
      "label": "Page Background Color",
      "default": "#FFFFFF",
      "info": "Fills the section background and the 'hole' in the hanger SVG."
    },
    {
      "type": "header",
      "content": "Left Card (Black)"
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Details Heading",
      "default": "Detaljer om produktet"
    },
    {
      "type": "header",
      "content": "Right Card (White)"
    },
    {
      "type": "text",
      "id": "includes_heading",
      "label": "Includes Heading",
      "default": "Hvad medfølger?"
    }
  ],
  "blocks": [
    {
      "type": "details_list",
      "name": "Details List (Black Card)",
      "settings": [
        {
          "type": "text",
          "id": "block_heading",
          "label": "List Heading",
          "default": "Funktioner"
        },
        {
          "type": "richtext",
          "id": "block_content",
          "label": "List Content",
          "default": "<ul><li>Cylinderformet</li><li>330 liter kapacitet</li><li>Sort farve</li><li>Oppusteligt design</li></ul>",
          "info": "Use bullet points in the editor."
        }
      ]
    },
    {
      "type": "included_item",
      "name": "Included Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Item Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Item Title",
          "default": "Håndpumpe"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Details",
      "blocks": [
        {
          "type": "details_list",
          "settings": {
            "block_heading": "Funktioner",
            "block_content": "<ul><li>Cylinderformet</li><li>330 liter kapacitet</li><li>Sort farve</li><li>Oppusteligt design</li></ul>"
          }
        },
        {
          "type": "details_list",
          "settings": {
            "block_heading": "Dimensioner",
            "block_content": "<ul><li>75 cm diameter</li><li>75 cm højde</li><li>Velegnet til højder op til 2,10m</li></ul>"
          }
        },
        {
          "type": "details_list",
          "settings": {
            "block_heading": "Konstruktion",
            "block_content": "<ul><li>Nylon udvendigt materiale</li><li>UV-resistent materiale</li><li>Skumisolering</li><li>None-rip polyester</li></ul>"
          }
        },
        {
          "type": "included_item",
          "settings": { "title": "Håndpumpe" }
        },
        {
          "type": "included_item",
          "settings": { "title": "Afløbshane" }
        },
        {
          "type": "included_item",
          "settings": { "title": "Afløbsslange" }
        },
        {
          "type": "included_item",
          "settings": { "title": "Overtræk" }
        }
      ]
    }
  ]
}
{% endschema %}