<div
  id="section-{{ section.id }}"
  class="whats-included-section"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="whats-included-container">
    <div class="hanger-tab" aria-hidden="true">
      <svg class="icon-box" viewBox="0 0 234 74" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="0" y="0" width="234" height="74" fill="currentColor"></rect>
        <rect x="58" y="32" width="118" height="19" class="svg-cutout"></rect>
        <circle cx="117.5" cy="32.5" r="11.5" class="svg-cutout"></circle>
      </svg>
    </div>

    {% if section.settings.heading != blank %}
      <h2 class="whats-included-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="whats-included-grid">
        {% for block in section.blocks %}
          <div class="included-item" {{ block.shopify_attributes }}>
            <div class="included-image-circle">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 200, height: 200, crop: 'center'
                  | image_tag: loading: 'lazy', alt: block.settings.title
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            {% if block.settings.title != blank %}
              <p class="included-title">{{ block.settings.title }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  #section-{{ section.id }}.whats-included-section {
    padding: 80px 20px;
    display: flex;
    justify-content: center;
  }

  #section-{{ section.id }} .whats-included-container {
    background-color: #f8f8f8;
    border-radius: 24px;
    padding: 60px 40px 50px;
    position: relative;
    max-width: 850px;
    width: 100%;
    text-align: center;
  }

  #section-{{ section.id }} .hanger-tab {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    width: 140px;
    color: #1a1a1a;
  }

  #section-{{ section.id }} .hanger-tab svg {
    width: 100%;
    height: auto;
    display: block;
  }

  #section-{{ section.id }} .svg-cutout {
    fill: {{ section.settings.bg_color }};
  }

  #section-{{ section.id }} .whats-included-heading {
    font-size: 32px;
    font-weight: 700;
    color: #111;
    margin-bottom: 40px;
    font-family: inherit;
  }

  #section-{{ section.id }} .whats-included-grid {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px;
  }

  #section-{{ section.id }} .included-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 140px;
  }

  #section-{{ section.id }} .included-image-circle {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background-color: #efefef;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 15px;
    overflow: hidden;
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.05);
  }

  #section-{{ section.id }} .included-image-circle img {
    width: 80%;
    height: 80%;
    object-fit: contain;
  }

  #section-{{ section.id }} .included-image-circle .placeholder-svg {
    width: 50%;
    height: 50%;
    fill: #ccc;
  }

  #section-{{ section.id }} .included-title {
    font-size: 16px;
    font-weight: 500;
    color: #333;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    #section-{{ section.id }} .whats-included-grid {
      gap: 15px;
    }

    #section-{{ section.id }} .included-item {
      width: 45%;
    }

    #section-{{ section.id }} .included-image-circle {
      width: 100px;
      height: 100px;
    }

    #section-{{ section.id }} .whats-included-heading {
      font-size: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "What's Included",
  "tag": "section",
  "class": "section-whats-included",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hvad medfølger?"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page Background Color",
      "default": "#FFFFFF",
      "info": "This color fills the hole in the hanger SVG so it matches the background behind the card."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Included Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Item Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Item Title",
          "default": "Item Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What's Included",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Håndpumpe"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Afløbshane"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Afløbsslange"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Overtræk"
          }
        }
      ]
    }
  ]
}
{% endschema %}
