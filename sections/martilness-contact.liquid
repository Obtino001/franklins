{%- liquid
  assign accent = section.settings.accent_color | default: '#09412d'
  assign phone = section.settings.phone | default: '+45 2779 6900'
  assign phone_href = phone | replace: ' ', '' | replace: '+', ''
  assign email = section.settings.email | default: 'info@martilness.dk'
  assign return_label = section.settings.return_link_label | default: 'returportal'
  assign claim_label = section.settings.claim_link_label | default: 'reklamationsside'
-%}

<div
  id="section-{{ section.id }}"
  class="mt-contact"
  style="
    --mt-contact-accent: {{ accent }};
    --mt-contact-pad-top: {{ section.settings.padding_top }}px;
    --mt-contact-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="mt-contact__wrap page-width">
    <div class="mt-contact__grid">
      <div class="mt-contact__info">
        {% if section.settings.heading != blank %}
          <h1 class="mt-contact__heading">{{ section.settings.heading }}</h1>
        {% endif %}

        {% if section.settings.intro != blank %}
          <div class="mt-contact__intro rte">{{ section.settings.intro }}</div>
        {% endif %}

        {% if section.settings.returns_heading != blank %}
          <h2 class="mt-contact__subheading">{{ section.settings.returns_heading }}</h2>
        {% endif %}

        {% if section.settings.returns_text != blank %}
          <p class="mt-contact__returns">
            {{ section.settings.returns_text }}
            {% if section.settings.return_link != blank %}
              <a href="{{ section.settings.return_link }}">{{ return_label }}</a>
            {% endif %}
            {{ section.settings.returns_mid }}
            {% if section.settings.claim_link != blank %}
              <a href="{{ section.settings.claim_link }}">{{ claim_label }}</a>
            {% endif %}{{ section.settings.returns_end }}
          </p>
        {% endif %}

        <div class="mt-contact__company">
          {% if section.settings.company != blank %}
            <p class="mt-contact__company-name">{{ section.settings.company }}</p>
          {% endif %}
          {% if section.settings.address != blank %}
            <div class="mt-contact__address">{{ section.settings.address }}</div>
          {% endif %}
        </div>

        <div class="mt-contact__links">
          {% if phone != blank %}
            <a class="mt-contact__link" href="tel:+{{ phone_href }}">
              <span class="mt-contact__link-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6.5 3.8h3.2l1.2 4-2 1.2a12.5 12.5 0 0 0 6.1 6.1l1.2-2 4 1.2v3.2a1.8 1.8 0 0 1-2 1.8 16.2 16.2 0 0 1-13.3-13.3 1.8 1.8 0 0 1 1.8-2z"/>
                </svg>
              </span>
              <span>Tlf.: {{ phone }}</span>
            </a>
          {% endif %}
          {% if email != blank %}
            <a class="mt-contact__link" href="mailto:{{ email }}">
              <span class="mt-contact__link-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3.2" y="5.2" width="17.6" height="13.6" rx="1.6"/>
                  <path d="m4 7 8 6 8-6"/>
                </svg>
              </span>
              <span>{{ email }}</span>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="mt-contact__form-wrap">
        {%- form 'contact', id: 'MartilnessContactForm', class: 'mt-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="mt-contact__status mt-contact__status--ok" role="status">
              Tak! Vi har modtaget din besked.
            </p>
          {%- elsif form.errors -%}
            <p class="mt-contact__status mt-contact__status--error" role="alert">
              {{- 'blocks.contact_form.error_heading' | t -}}
            </p>
          {%- endif -%}

          <div class="mt-contact__field mt-contact__field--full">
            <label for="mt-contact-name">Navn</label>
            <input
              id="mt-contact-name"
              type="text"
              name="contact[Navn]"
              autocomplete="name"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <div class="mt-contact__row">
            <div class="mt-contact__field">
              <label for="mt-contact-email">E-mail</label>
              <input
                id="mt-contact-email"
                type="email"
                name="contact[email]"
                autocomplete="email"
                required
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              >
            </div>
            <div class="mt-contact__field">
              <label for="mt-contact-phone">Telefon</label>
              <input
                id="mt-contact-phone"
                type="tel"
                name="contact[Telefon]"
                autocomplete="tel"
              >
            </div>
          </div>

          <div class="mt-contact__field mt-contact__field--full">
            <label for="mt-contact-message">Meddelelse</label>
            <textarea
              id="mt-contact-message"
              name="contact[Meddelelse]"
              rows="6"
            >{{- form.body -}}</textarea>
          </div>

          <button type="submit" class="mt-contact__submit">Indsend besked</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<style>
  #section-{{ section.id }}.mt-contact {
    padding: var(--mt-contact-pad-top) var(--page-padding, 1.6rem) var(--mt-contact-pad-bottom);
    background: #fff;
  }

  #section-{{ section.id }} .mt-contact__wrap {
    max-width: var(--page-width, 1500px);
    margin: 0 auto;
  }

  #section-{{ section.id }} .mt-contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.2rem;
    align-items: start;
  }

  #section-{{ section.id }} .mt-contact__heading {
    margin: 0 0 1.6rem;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(2.8rem, 4vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: #111;
  }

  #section-{{ section.id }} .mt-contact__intro,
  #section-{{ section.id }} .mt-contact__returns,
  #section-{{ section.id }} .mt-contact__address {
    margin: 0 0 1.4rem;
    font-size: 1.5rem;
    line-height: 1.65;
    color: rgb(0 0 0 / 78%);
  }

  #section-{{ section.id }} .mt-contact__intro p {
    margin: 0 0 1rem;
  }

  #section-{{ section.id }} .mt-contact__intro p:last-child {
    margin-bottom: 0;
  }

  #section-{{ section.id }} .mt-contact__subheading {
    margin: 2.4rem 0 0.8rem;
    font-size: 1.7rem;
    font-weight: 700;
    color: #111;
  }

  #section-{{ section.id }} .mt-contact__returns a {
    color: var(--mt-contact-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  #section-{{ section.id }} .mt-contact__company {
    margin: 2.4rem 0 1.6rem;
    font-size: 1.5rem;
    line-height: 1.6;
    color: #111;
  }

  #section-{{ section.id }} .mt-contact__company-name {
    margin: 0 0 0.2rem;
    font-weight: 700;
  }

  #section-{{ section.id }} .mt-contact__address p {
    margin: 0;
  }

  #section-{{ section.id }} .mt-contact__links {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  #section-{{ section.id }} .mt-contact__link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--mt-contact-accent);
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  #section-{{ section.id }} .mt-contact__link:hover {
    text-decoration: underline;
  }

  #section-{{ section.id }} .mt-contact__link-icon {
    width: 1.8rem;
    height: 1.8rem;
    flex: none;
  }

  #section-{{ section.id }} .mt-contact__link-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #section-{{ section.id }} .mt-contact__form-wrap {
    background: #f3f4f3;
    border-radius: 0.4rem;
    padding: 2.4rem 2rem;
  }

  #section-{{ section.id }} .mt-contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  #section-{{ section.id }} .mt-contact__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  #section-{{ section.id }} .mt-contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  #section-{{ section.id }} .mt-contact__field label {
    font-size: 1.4rem;
    font-weight: 600;
    color: #111;
  }

  #section-{{ section.id }} .mt-contact__field input,
  #section-{{ section.id }} .mt-contact__field textarea {
    width: 100%;
    border: 1px solid rgb(0 0 0 / 10%);
    background: #fff;
    border-radius: 0.2rem;
    padding: 1.1rem 1.2rem;
    font: inherit;
    font-size: 1.5rem;
    color: #111;
  }

  #section-{{ section.id }} .mt-contact__field textarea {
    min-height: 14rem;
    resize: vertical;
  }

  #section-{{ section.id }} .mt-contact__submit {
    width: 100%;
    border: 0;
    background: var(--mt-contact-accent);
    color: #fff;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 1.4rem 1.6rem;
    cursor: pointer;
  }

  #section-{{ section.id }} .mt-contact__submit:hover {
    filter: brightness(1.08);
  }

  #section-{{ section.id }} .mt-contact__status {
    margin: 0;
    font-size: 1.4rem;
  }

  #section-{{ section.id }} .mt-contact__status--ok {
    color: var(--mt-contact-accent);
  }

  #section-{{ section.id }} .mt-contact__status--error {
    color: #b42318;
  }

  @media screen and (min-width: 750px) {
    #section-{{ section.id }} .mt-contact__row {
      grid-template-columns: 1fr 1fr;
    }

    #section-{{ section.id }} .mt-contact__form-wrap {
      padding: 3.2rem;
    }
  }

  @media screen and (min-width: 990px) {
    #section-{{ section.id }} .mt-contact__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 6rem;
    }
  }
</style>

{% schema %}
{
  "name": "Martilness contact",
  "tag": "section",
  "class": "section-mt-contact",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vi er her for at hjælpe!"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Hvis du har spørgsmål, store som små, eller har brug for mere information om vores produkter, tøv endelig ikke med at kontakte os. Vores team står klar til at hjælpe dig, så du får den bedste oplevelse og de svar, du søger.</p><p>Vi glæder os til at høre fra dig!</p>"
    },
    {
      "type": "text",
      "id": "returns_heading",
      "label": "Returns heading",
      "default": "Returnering eller reklamation"
    },
    {
      "type": "text",
      "id": "returns_text",
      "label": "Returns text start",
      "default": "Skal du returnere eller reklamere over et produkt kan du gå direkte her til vores"
    },
    {
      "type": "text",
      "id": "returns_mid",
      "label": "Returns text middle",
      "default": " eller vores "
    },
    {
      "type": "text",
      "id": "returns_end",
      "label": "Returns text end",
      "default": "."
    },
    {
      "type": "url",
      "id": "return_link",
      "label": "Return portal link"
    },
    {
      "type": "text",
      "id": "return_link_label",
      "label": "Return link label",
      "default": "returportal"
    },
    {
      "type": "url",
      "id": "claim_link",
      "label": "Complaint page link"
    },
    {
      "type": "text",
      "id": "claim_link_label",
      "label": "Complaint link label",
      "default": "reklamationsside"
    },
    {
      "type": "text",
      "id": "company",
      "label": "Company name",
      "default": "Martilness"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>Baunebakkevej 12, 2.th<br/>2650 Hvidovre<br/>CVR: 35633146</p>"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+45 2779 6900"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@martilness.dk"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent green",
      "default": "#09412d"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Martilness contact"
    }
  ]
}
{% endschema %}
