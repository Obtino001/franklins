{%- doc -%}
  Payment badge. Official MobilePay / Google Pay SVGs; other types use Shopify icons.

  @param {string} type - Payment type key (mobilepay, google_pay, visa, ...)
{%- enddoc -%}

{%- case type -%}
  {%- when 'mobilepay' -%}
    <svg
      class="icon icon--full-color"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-labelledby="pi-mobilepay"
      viewBox="0 0 38 24"
      width="38"
      height="24"
    >
      <title id="pi-mobilepay">MobilePay</title>
      <rect width="38" height="24" rx="3" fill="#5A78FF"/>
      <text
        x="19"
        y="15.2"
        text-anchor="middle"
        fill="#fff"
        font-family="Arial, Helvetica, sans-serif"
        font-size="6.2"
        font-weight="700"
      >MobilePay</text>
    </svg>
  {%- when 'google_pay' -%}
    <svg
      class="icon icon--full-color"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-labelledby="pi-google-pay"
      viewBox="0 0 38 24"
      width="38"
      height="24"
    >
      <title id="pi-google-pay">Google Pay</title>
      <rect width="38" height="24" rx="3" fill="#fff"/>
      <rect x=".4" y=".4" width="37.2" height="23.2" rx="2.6" fill="none" stroke="#e0e0e0"/>
      <g transform="translate(4.2 6.2)">
        <path fill="#4285F4" d="M7.4 6.1c0-.4-.03-.8-.1-1.18H3.78v2.23h2.04c-.09.48-.36.88-.76 1.16v1.36h1.23c.72-.66 1.13-1.64 1.13-2.57z"/>
        <path fill="#34A853" d="M3.78 11.64c1.03 0 1.9-.34 2.53-.93l-1.23-1.36c-.34.23-.78.37-1.3.37-.99 0-1.84-.67-2.14-1.58H.37v1.4c.64 1.27 1.95 2.1 3.41 2.1z"/>
        <path fill="#FBBC04" d="M1.64 8.14c-.16-.47-.16-.98 0-1.45V5.3H.37c-.48.95-.48 2.08 0 3.03l1.27-.19z"/>
        <path fill="#EA4335" d="M3.78 3.5c.56 0 1.07.19 1.47.57l1.1-1.1C5.67 2.32 4.8 2 3.78 2 2.32 2 1.01 2.83.37 4.1l1.27 1.4C1.94 4.17 2.79 3.5 3.78 3.5z"/>
      </g>
      <text
        x="26.2"
        y="15.4"
        text-anchor="middle"
        fill="#3c4043"
        font-family="Arial, Helvetica, sans-serif"
        font-size="7.4"
        font-weight="500"
      >Pay</text>
    </svg>
  {%- else -%}
    {{ type | payment_type_svg_tag }}
{%- endcase -%}
