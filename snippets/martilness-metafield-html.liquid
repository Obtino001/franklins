{%- doc -%}
  Renders a product metafield as HTML.
  Rich text must use metafield_tag. Flat/broken list text is normalized to <ul><li> in the browser.
  LED color names (Rød, Blå, …) get colored circle swatches automatically.

  @param {object} metafield - product.metafields.namespace.key
  @param {boolean} [color_swatches] - force color dots (default: auto when color names detected)
  @param {boolean} [format_list] - force flat "Label: value" text into a bullet list (default true)
{%- enddoc -%}
{%- liquid
  if format_list == nil
    assign format_list = true
  endif
-%}
{%- if metafield != blank -%}
  <div
    class="mt-pdp-tab rte{% if color_swatches %} mt-pdp-tab--swatches{% endif %}"
    data-mt-pdp-metafield
    {% if format_list %}data-mt-format-list{% endif %}
    data-mt-color-swatches
  >
    {%- case metafield.type -%}
      {%- when 'multi_line_text_field' -%}
        {%- assign mf_lines = metafield.value | strip | newline_to_br | split: '<br />' -%}
        {%- if mf_lines.size > 1 -%}
          <ul class="mt-pdp-tab__list">
            {%- for line in mf_lines -%}
              {%- assign line_text = line | strip_html | strip -%}
              {%- if line_text != blank -%}
                <li>{{ line_text }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="mt-pdp-tab__text">{{ metafield.value | newline_to_br }}</div>
        {%- endif -%}
      {%- when 'single_line_text_field' -%}
        <p>{{ metafield.value }}</p>
      {%- else -%}
        {{ metafield | metafield_tag }}
      {%- endcase -%}
  </div>

  <style>
    .mt-pdp-tab--swatches .metafield-rich_text_field ul,
    .mt-pdp-tab--swatches .mt-pdp-tab__list,
    .mt-pdp-tab__list--colors,
    .mt-pd-block__list .mt-pdp-tab__list {
      list-style: none;
      padding-left: 0;
    }
    .mt-pdp-tab__swatch-row {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      list-style: none;
    }
    .mt-color-dot {
      flex: 0 0 auto;
      width: 1.15rem;
      height: 1.15rem;
      margin-top: 0.3rem;
      border-radius: 999px;
      box-shadow: inset 0 0 0 0.1rem rgb(0 0 0 / 8%);
    }
    .mt-color-dot--rod { background: #e53935; }
    .mt-color-dot--bla { background: #42a5f5; }
    .mt-color-dot--gron { background: #43a047; }
    .mt-color-dot--gul { background: #fdd835; }
    .mt-color-dot--lilla { background: #8e24aa; }
    .mt-color-dot--orange { background: #fb8c00; }
    .mt-color-dot--cyan { background: #26c6da; border-radius: 0.2rem; }
    .mt-color-dot--nir { background: #111; }
  </style>

  <script>
    (() => {
      const root = document.currentScript && document.currentScript.previousElementSibling;
      if (!root || !root.hasAttribute('data-mt-pdp-metafield')) return;
      if (root.dataset.mtMetaBound === 'true') return;
      root.dataset.mtMetaBound = 'true';

      const formatList = root.hasAttribute('data-mt-format-list');
      const COLOR_MAP = [
        ['nærinfrarød', 'nir'],
        ['narinfrarod', 'nir'],
        ['orange', 'orange'],
        ['lilla', 'lilla'],
        ['cyan', 'cyan'],
        ['grøn', 'gron'],
        ['blå', 'bla'],
        ['rød', 'rod'],
        ['gul', 'gul']
      ];

      function applyColorSwatches(scope) {
        if (!scope) return;
        let hit = false;
        scope.querySelectorAll('li, p').forEach(function (el) {
          if (el.querySelector('.mt-color-dot')) return;
          const raw = (el.textContent || '').trim();
          const text = raw.toLowerCase();
          if (!text || text.indexOf('hvad hjælper') === 0) return;

          for (var i = 0; i < COLOR_MAP.length; i++) {
            var name = COLOR_MAP[i][0];
            var cls = COLOR_MAP[i][1];
            if (text.indexOf(name) === 0 || text.indexOf(name + ':') === 0 || text.indexOf(name + ' (') === 0) {
              var dot = document.createElement('span');
              dot.className = 'mt-color-dot mt-color-dot--' + cls;
              dot.setAttribute('aria-hidden', 'true');
              el.insertBefore(dot, el.firstChild);
              el.classList.add('mt-pdp-tab__swatch-row');
              hit = true;
              break;
            }
          }
        });
        if (hit) scope.classList.add('mt-pdp-tab--swatches');
      }

      if (formatList) {
        const existingLis = root.querySelectorAll('li');
        const looksLikeList = existingLis.length >= 2;

        if (!looksLikeList) {
          const text = (root.innerText || '').replace(/\s+/g, ' ').trim();
          const labels = [
            'Nærinfrarød (NIR)',
            'Nærinfrarødt lys',
            'Nærinfrarød',
            'Antal LED-lamper',
            'Certificeringer',
            'Tidsindstilling',
            'Strømforbrug',
            'Strømstyrke',
            'Temperatur',
            'Materiale',
            'Betjening',
            'Spænding',
            'Størrelse',
            'LED-lys',
            'Orange',
            'Lilla',
            'Cyan',
            'Grøn',
            'Blå',
            'Rød',
            'Gul',
            'Vægt',
            'ROHS'
          ].sort(function (a, b) { return b.length - a.length; });

          const escaped = labels.map(function (l) {
            return l.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          }).join('|');

          let parts = [];
          if (escaped) {
            parts = text
              .split(new RegExp('(?=(?:' + escaped + ')\\s*:)', 'gi'))
              .map(function (p) { return p.trim(); })
              .filter(Boolean);
          }

          if (parts.length < 2) {
            parts = text
              .split(/(?=(?:[A-ZÆØÅ][a-zæøåA-ZÆØÅ-]{2,40})\s*:)/)
              .map(function (p) { return p.trim(); })
              .filter(Boolean);
          }

          if (parts.length >= 2) {
            const ul = document.createElement('ul');
            ul.className = 'mt-pdp-tab__list';
            parts.forEach(function (part) {
              const li = document.createElement('li');
              li.textContent = part;
              ul.appendChild(li);
            });
            root.innerHTML = '';
            root.appendChild(ul);
          }
        }
      }

      applyColorSwatches(root);
    })();
  </script>
{%- endif -%}
