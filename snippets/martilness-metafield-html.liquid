{%- doc -%}
  Renders a product metafield as HTML.
  Rich text must use metafield_tag. Flat/broken list text is normalized to <ul><li> in the browser.

  @param {object} metafield - product.metafields.namespace.key
  @param {boolean} [color_swatches] - inject colored dots for LED therapy colors
  @param {boolean} [format_list] - force flat "Label: value" text into a bullet list (default true)
{%- enddoc -%}
{%- liquid
  if format_list == nil
    assign format_list = true
  endif
-%}
{%- if metafield != blank -%}
  <div
    class="mt-pdp-tab rte{% if color_swatches %} mt-pdp-tab--swatches{% endif %}"
    data-mt-pdp-metafield
    {% if format_list %}data-mt-format-list{% endif %}
    {% if color_swatches %}data-mt-color-swatches{% endif %}
  >
    {%- case metafield.type -%}
      {%- when 'multi_line_text_field' -%}
        {%- assign mf_lines = metafield.value | strip | newline_to_br | split: '<br />' -%}
        {%- if mf_lines.size > 1 -%}
          <ul class="mt-pdp-tab__list">
            {%- for line in mf_lines -%}
              {%- assign line_text = line | strip_html | strip -%}
              {%- if line_text != blank -%}
                <li>{{ line_text }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="mt-pdp-tab__text">{{ metafield.value | newline_to_br }}</div>
        {%- endif -%}
      {%- when 'single_line_text_field' -%}
        <p>{{ metafield.value }}</p>
      {%- else -%}
        {{ metafield | metafield_tag }}
      {%- endcase -%}
  </div>

  <script>
    (() => {
      const root = document.currentScript && document.currentScript.previousElementSibling;
      if (!root || !root.hasAttribute('data-mt-pdp-metafield')) return;
      if (root.dataset.mtMetaBound === 'true') return;
      root.dataset.mtMetaBound = 'true';

      const formatList = root.hasAttribute('data-mt-format-list');
      const colorSwatches = root.hasAttribute('data-mt-color-swatches');

      if (formatList) {
        const existingLis = root.querySelectorAll('li');
        const looksLikeList = existingLis.length >= 2;

        if (!looksLikeList) {
          const text = (root.innerText || '').replace(/\s+/g, ' ').trim();
          const labels = [
            'Antal LED-lamper',
            'Nærinfrarødt lys',
            'Certificeringer',
            'Tidsindstilling',
            'Strømforbrug',
            'Strømstyrke',
            'Temperatur',
            'Materiale',
            'Betjening',
            'Spænding',
            'Størrelse',
            'LED-lys',
            'Vægt',
            'ROHS'
          ].sort(function (a, b) { return b.length - a.length; });

          const escaped = labels.map(function (l) {
            return l.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          }).join('|');

          let parts = [];
          if (escaped) {
            parts = text
              .split(new RegExp('(?=(?:' + escaped + ')\\s*:)', 'g'))
              .map(function (p) { return p.trim(); })
              .filter(Boolean);
          }

          if (parts.length < 2) {
            parts = text
              .split(/(?=(?:[A-ZÆØÅ][^\n:]{1,40}):)/)
              .map(function (p) { return p.trim(); })
              .filter(Boolean);
          }

          if (parts.length >= 2) {
            const ul = document.createElement('ul');
            ul.className = 'mt-pdp-tab__list';
            parts.forEach(function (part) {
              const li = document.createElement('li');
              li.textContent = part;
              ul.appendChild(li);
            });
            root.innerHTML = '';
            root.appendChild(ul);
          }
        }
      }

      if (colorSwatches) {
        const map = [
          ['rød', 'rod'],
          ['blå', 'bla'],
          ['grøn', 'gron'],
          ['gul', 'gul'],
          ['lilla', 'lilla'],
          ['orange', 'orange'],
          ['cyan', 'cyan'],
          ['nærinfrarød', 'nir'],
          ['narinfrarod', 'nir']
        ];

        root.querySelectorAll('li, p').forEach(function (el) {
          if (el.querySelector('.mt-color-dot')) return;
          const text = (el.textContent || '').trim().toLowerCase();
          if (!text || text.indexOf('hvad hjælper') === 0) return;

          for (var i = 0; i < map.length; i++) {
            var name = map[i][0];
            var cls = map[i][1];
            if (text.indexOf(name) === 0) {
              var dot = document.createElement('span');
              dot.className = 'mt-color-dot mt-color-dot--' + cls;
              dot.setAttribute('aria-hidden', 'true');
              el.insertBefore(dot, el.firstChild);
              el.classList.add('mt-pdp-tab__swatch-row');
              break;
            }
          }
        });
      }
    })();
  </script>
{%- endif -%}
