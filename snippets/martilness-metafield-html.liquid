{%- doc -%}
  Renders a product metafield as HTML.
  Rich text metafields must use metafield_tag (raw .value dumps JSON).
  Optionally injects color swatches for LED light therapy color names (WP match).

  @param {object} metafield - product.metafields.namespace.key
  @param {boolean} [color_swatches] - inject colored dots before color names
{%- enddoc -%}
{%- if metafield != blank and metafield.value != blank -%}
  {%- capture mf_html -%}
    {%- if metafield.type == 'rich_text_field' -%}
      {{ metafield | metafield_tag }}
    {%- else -%}
      {{ metafield.value }}
    {%- endif -%}
  {%- endcapture -%}

  {%- if color_swatches -%}
    {%- assign mf_html = mf_html
      | replace: '<strong>Rød', '<span class="mt-color-dot mt-color-dot--rod" aria-hidden="true"></span><strong>Rød'
      | replace: '<strong>Blå', '<span class="mt-color-dot mt-color-dot--bla" aria-hidden="true"></span><strong>Blå'
      | replace: '<strong>Grøn', '<span class="mt-color-dot mt-color-dot--gron" aria-hidden="true"></span><strong>Grøn'
      | replace: '<strong>Gul', '<span class="mt-color-dot mt-color-dot--gul" aria-hidden="true"></span><strong>Gul'
      | replace: '<strong>Lilla', '<span class="mt-color-dot mt-color-dot--lilla" aria-hidden="true"></span><strong>Lilla'
      | replace: '<strong>Orange', '<span class="mt-color-dot mt-color-dot--orange" aria-hidden="true"></span><strong>Orange'
      | replace: '<strong>Cyan', '<span class="mt-color-dot mt-color-dot--cyan" aria-hidden="true"></span><strong>Cyan'
      | replace: '<strong>Nærinfrarød', '<span class="mt-color-dot mt-color-dot--nir" aria-hidden="true"></span><strong>Nærinfrarød'
      | replace: '<li>Rød', '<li><span class="mt-color-dot mt-color-dot--rod" aria-hidden="true"></span>Rød'
      | replace: '<li>Blå', '<li><span class="mt-color-dot mt-color-dot--bla" aria-hidden="true"></span>Blå'
      | replace: '<li>Grøn', '<li><span class="mt-color-dot mt-color-dot--gron" aria-hidden="true"></span>Grøn'
      | replace: '<li>Gul', '<li><span class="mt-color-dot mt-color-dot--gul" aria-hidden="true"></span>Gul'
      | replace: '<li>Lilla', '<li><span class="mt-color-dot mt-color-dot--lilla" aria-hidden="true"></span>Lilla'
      | replace: '<li>Orange', '<li><span class="mt-color-dot mt-color-dot--orange" aria-hidden="true"></span>Orange'
      | replace: '<li>Cyan', '<li><span class="mt-color-dot mt-color-dot--cyan" aria-hidden="true"></span>Cyan'
      | replace: '<li>Nærinfrarød', '<li><span class="mt-color-dot mt-color-dot--nir" aria-hidden="true"></span>Nærinfrarød'
      | replace: '<p>Rød', '<p><span class="mt-color-dot mt-color-dot--rod" aria-hidden="true"></span>Rød'
      | replace: '<p>Blå', '<p><span class="mt-color-dot mt-color-dot--bla" aria-hidden="true"></span>Blå'
      | replace: '<p>Grøn', '<p><span class="mt-color-dot mt-color-dot--gron" aria-hidden="true"></span>Grøn'
      | replace: '<p>Gul', '<p><span class="mt-color-dot mt-color-dot--gul" aria-hidden="true"></span>Gul'
      | replace: '<p>Lilla', '<p><span class="mt-color-dot mt-color-dot--lilla" aria-hidden="true"></span>Lilla'
      | replace: '<p>Orange', '<p><span class="mt-color-dot mt-color-dot--orange" aria-hidden="true"></span>Orange'
      | replace: '<p>Cyan', '<p><span class="mt-color-dot mt-color-dot--cyan" aria-hidden="true"></span>Cyan'
      | replace: '<p>Nærinfrarød', '<p><span class="mt-color-dot mt-color-dot--nir" aria-hidden="true"></span>Nærinfrarød'
    -%}
  {%- endif -%}

  <div class="mt-pdp-tab rte{% if color_swatches %} mt-pdp-tab--swatches{% endif %}">
    {{ mf_html }}
  </div>
{%- endif -%}
