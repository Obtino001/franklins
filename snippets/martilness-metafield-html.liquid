{%- doc -%}
  Renders a product metafield as HTML.
  Always prefer metafield_tag for rich text — printing .value flattens lists into one paragraph.

  @param {object} metafield - product.metafields.namespace.key
  @param {boolean} [color_swatches] - inject colored dots for LED therapy colors
{%- enddoc -%}
{%- if metafield != blank -%}
  <div
    class="mt-pdp-tab rte{% if color_swatches %} mt-pdp-tab--swatches{% endif %}"
    {% if color_swatches %}data-mt-color-swatches{% endif %}
  >
    {%- case metafield.type -%}
      {%- when 'multi_line_text_field' -%}
        {%- assign mf_lines = metafield.value | strip | newline_to_br | split: '<br />' -%}
        {%- if mf_lines.size > 1 -%}
          <ul class="mt-pdp-tab__list">
            {%- for line in mf_lines -%}
              {%- assign line_text = line | strip_html | strip -%}
              {%- if line_text != blank -%}
                <li>{{ line_text }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="mt-pdp-tab__text">{{ metafield.value | newline_to_br }}</div>
        {%- endif -%}
      {%- when 'single_line_text_field' -%}
        <p>{{ metafield.value }}</p>
      {%- else -%}
        {{ metafield | metafield_tag }}
      {%- endcase -%}
  </div>

  {%- if color_swatches -%}
    <script>
      (() => {
        const root = document.currentScript && document.currentScript.previousElementSibling;
        if (!root || !root.hasAttribute('data-mt-color-swatches')) return;
        if (root.dataset.mtSwatchesBound === 'true') return;
        root.dataset.mtSwatchesBound = 'true';

        const map = [
          ['rød', 'rod'],
          ['blå', 'bla'],
          ['grøn', 'gron'],
          ['gul', 'gul'],
          ['lilla', 'lilla'],
          ['orange', 'orange'],
          ['cyan', 'cyan'],
          ['nærinfrarød', 'nir'],
          ['narinfrarod', 'nir']
        ];

        root.querySelectorAll('li, p').forEach((el) => {
          if (el.querySelector('.mt-color-dot')) return;
          const text = (el.textContent || '').trim().toLowerCase();
          if (!text || text.startsWith('hvad hjælper')) return;

          for (const [name, cls] of map) {
            if (text.startsWith(name)) {
              const dot = document.createElement('span');
              dot.className = 'mt-color-dot mt-color-dot--' + cls;
              dot.setAttribute('aria-hidden', 'true');
              el.insertBefore(dot, el.firstChild);
              el.classList.add('mt-pdp-tab__swatch-row');
              break;
            }
          }
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}
