                  "blocks": {
                    "custom_liquid_ndXJrb": {
                      "type": "custom-liquid",
                      "name": "t:names.custom_liquid",
                      "settings": {
                        "custom_liquid": "{%- comment -%}\n  Produkt-specifikationer (metafelter) — bygget efter Pebbles egne konventioner.\n  Lægges i en Custom Liquid-blok inde i en collapsible row under \"Specifikationer\".\n  Tomme felter skjules automatisk. Rækkefølgen styres af listen nedenfor.\n{%- endcomment -%}\n\n{%- capture fields_config -%}\n  thca_indhold|custom|%\n  cbd_indhold|produkt|%\n  thc_indhold|custom|%\n  genetik|custom|\n  terpenprofil|custom|\n  oprindelsesland|custom|\n  dyrkningsmetode|custom|\n  konsistens|custom|\n  farve|custom|\n  storrelse|custom|\n  gram|custom|g\n  diameter|custom|mm\n  antal_lag|custom|lag\n  antal_pr_pakke|custom|stk\n  papirstype|custom|\n  ingredienser|custom|\n  brand|custom|\n{%- endcapture -%}\n\n<dl class=\"product-specs\">\n  {%- assign field_lines = fields_config | newline_to_br | split: '<br />' -%}\n  {%- for line in field_lines -%}\n    {%- assign clean = line | strip -%}\n    {%- if clean == '' -%}{%- continue -%}{%- endif -%}\n\n    {%- assign parts = clean | split: '|' -%}\n    {%- assign key = parts[0] | strip -%}\n    {%- assign ns = parts[1] | strip -%}\n    {%- assign suffix = parts[2] | default: '' | strip -%}\n\n    {%- assign mf = product.metafields[ns][key] -%}\n    {%- if mf == blank -%}{%- continue -%}{%- endif -%}\n\n    {%- assign value = mf | default: '' | strip -%}\n    {%- if value == '' -%}{%- continue -%}{%- endif -%}\n\n    {%- case key -%}\n      {%- when 'brand' -%}{%- assign label = 'Brand' -%}\n      {%- when 'storrelse' -%}{%- assign label = 'Størrelse' -%}\n      {%- when 'oprindelsesland' -%}{%- assign label = 'Oprindelsesland' -%}\n      {%- when 'genetik' -%}{%- assign label = 'Genetik' -%}\n      {%- when 'dyrkningsmetode' -%}{%- assign label = 'Dyrkningsmetode' -%}\n      {%- when 'terpenprofil' -%}{%- assign label = 'Terpenprofil' -%}\n      {%- when 'konsistens' -%}{%- assign label = 'Konsistens' -%}\n      {%- when 'farve' -%}{%- assign label = 'Farve' -%}\n      {%- when 'diameter' -%}{%- assign label = 'Diameter' -%}\n      {%- when 'gram' -%}{%- assign label = 'Gram' -%}\n      {%- when 'antal_lag' -%}{%- assign label = 'Antal lag' -%}\n      {%- when 'antal_pr_pakke' -%}{%- assign label = 'Antal pr. pakke' -%}\n      {%- when 'papirstype' -%}{%- assign label = 'Papirstype' -%}\n      {%- when 'ingredienser' -%}{%- assign label = 'Ingredienser' -%}\n      {%- when 'thca_indhold' -%}{%- assign label = 'THCA indhold' -%}\n      {%- when 'thc_indhold' -%}{%- assign label = 'THC indhold' -%}\n      {%- when 'cbd_indhold' -%}{%- assign label = 'CBD indhold' -%}\n      {%- else -%}{%- assign label = key | replace: '_', ' ' | capitalize -%}\n    {%- endcase -%}\n\n    <div class=\"product-specs__row\">\n      <dt class=\"product-specs__label\">{{ label }}</dt>\n      <dd class=\"product-specs__value color-subtext\">\n        {%- if key == 'ingredienser' -%}\n          {{ value | newline_to_br }}\n        {%- else -%}\n          {{ value }}{% if suffix != '' %}{% if suffix == '%' %}{{ suffix }}{% else %} {{ suffix }}{% endif %}{% endif %}\n        {%- endif -%}\n      </dd>\n    </div>\n  {%- endfor -%}\n</dl>\n\n<style>\n  .product-specs {\n    margin: 0;\n  }\n  .product-specs__row {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 1.6rem;\n    padding-block: 1.2rem;\n    border-block-end: 0.1rem solid rgb(var(--color-border) / var(--color-border-alpha));\n  }\n  .product-specs__row:first-child {\n    padding-block-start: 0;\n  }\n  .product-specs__row:last-child {\n    padding-block-end: 0;\n    border-block-end: 0;\n  }\n  .product-specs__label {\n    margin: 0;\n    font-weight: 500;\n    flex-shrink: 0;\n  }\n  .product-specs__value {\n    margin: 0;\n    text-align: end;\n    line-height: 1.4;\n  }\n</style>",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
