e":false,"shape":"circle","subtext":"","subtext_type_preset":"h6","subtext_font":"var(--font-body--family)","subtext_font_weight":"","subtext_font_size":15,"subtext_font_size_mobile":15,"subtext_line_height":"normal","subtext_text_color":"#000000","text":"Enkelt","type_preset":"h5","font":"var(--font-body--family)","font_weight":"","font_size":15,"font_size_mobile":15,"line_height":"normal","text_color":"#000000","background_color":"#ffc8c8","round_shape":false,"border_radius":0,"rotate":-24,"width":110,"width_mobile":90,"offset_top":66,"offset_left":82,"offset_top_mobile":66,"offset_left_mobile":74,"loop_animation":"float-up"},"blocks":{}}},"block_order":["badge_n3exmi","badge_NcXBiT"]}},"block_order":["image_with_badges_VDcFDi"]}},"block_order":["group_t6aEJJ","group_4PqLBm"],"name":"t:names.custom_section","settings":{"container":"page-width","content_direction":"row","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","horizontal_alignment_flex_direction_column":"flex-start","column_gap":0,"row_gap":0,"column_gap_mobile":0,"row_gap_mobile":40,"use_color_scheme_in_container":false,"color_scheme":"","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"device":"desktop","padding-block-start":100,"padding-block-end":100,"padding-inline-start":0,"padding-inline-end":0,"padding-block-start-mobile":48,"padding-block-end-mobile":48,"padding-inline-start-mobile":0,"padding-inline-end-mobile":0}},"custom_section_9C4tqY":{"type":"custom-section","blocks":{"text_DhxWjD":{"type":"text","name":"t:names.text","settings":{"text":"<h2><strong>Lovlig CBD og THCA – testet, dokumenteret og uden gætteri<\/strong><\/h2><p>Hos os finder du et nøje udvalgt sortiment af laboratorietestet CBD og THCA – fremstillet af EU-certificeret industrihamp, under 0,2% THC og 100% lovligt i Danmark. Det, der står på etiketten, er det du får.<\/p><p>Vi samarbejder kun med producenter, der dyrker under kontrollerede forhold uden pesticider eller skadelige kemikalier. Hvert parti analyseres af et uafhængigt laboratorium for CBD- og THCA-indhold, THC-niveau og renhed – inden det kommer på lager. Du finder certifikaterne direkte på produktsiderne og samlet på vores <a href=\"https:\/\/franklins.dk\/pages\/certifikater\">side med laboratorieanalyser og certifikater for hvert enkelt parti<\/a>.<\/p><h2><strong>Vores sortiment – CBD hash, THCA hash, topskud og olie<\/strong><\/h2><p>Vi fører <a href=\"https:\/\/franklins.dk\/collections\/cbd-topskud\">CBD topskud<\/a>, <a href=\"https:\/\/franklins.dk\/collections\/thca-topskud\">THCA topskud<\/a>, <a href=\"https:\/\/franklins.dk\/collections\/cbd-hash\">CBD hash<\/a>, <a href=\"https:\/\/franklins.dk\/collections\/thca-hash\">THCA hash i varianter fra 22% til 60% THCA<\/a> samt <a href=\"https:\/\/franklins.dk\/collections\/cbd-olie\">bredspektret CBD olie i 10%, 15%, 20% og 30%<\/a>. Sortimentet opdateres løbende – du handler altid fra et aktuelt udvalg af lovligt CBD og THCA i Danmark. Er du ny, anbefaler vi at starte med en af vores <a href=\"https:\/\/franklins.dk\/collections\/testpakker\">prøvepakker med variation på tværs af CBD og THCA<\/a>.<\/p><h2><strong>Hurtig og diskret levering fra Danmark<\/strong><\/h2><p>Alle ordrer sendes direkte fra vores danske lager. Vi afsender alle hverdage og leverer dag-til-dag i neutral emballage uden logoer eller produktnavne – uanset om du bor i København, Aarhus, Odense eller et mindre sted. Fri fragt til pakkeshop ved køb over 499 kr. Du modtager sporingsmail så du altid ved hvor din pakke er. Alle leveringsdetaljer finder du på vores <a href=\"https:\/\/franklins.dk\/pages\/leveringspolitik\">leveringspolitikside med oversigt over forsendelsesmetoder og tidsrammer<\/a>.<\/p><h2><strong>Dansk butik og webshop – gennemsigtig handel uden forvirring<\/strong><\/h2><p>Vi er skabt til dig, der vil handle lovligt og gennemsigtigt. Ingen gråzoner. Ingen overraskelser. Vi er en dansk butik med fysisk tilstedeværelse og direkte adgang til os – det betyder ansvar og produkter vi selv har valgt og verificeret. Vil du vide mere om os og vores tilgang, finder du det på vores <a href=\"https:\/\/franklins.dk\/pages\/om-os\">side om hvem vi er og hvad der driver vores krav til kvalitet og dokumentation<\/a>. Har du spørgsmål, finder du svar på vores <a href=\"https:\/\/franklins.dk\/pages\/faq\">FAQ-side med de mest stillede spørgsmål om produkter, levering og lovlighed<\/a>.<\/p>","highlight_style":"none","highlight_font_style":"italic","highlight_shape_color":"","highlight_text_color":"","type_preset":"rte","font":"var(--font-body--family)","font_weight":"","font_size":15,"font_size_mobile":15,"line_height":"normal","text_color":"text","text_color_gradient":"","disable_line_break_mobile":false,"width":"fit-content","text_alignment":"left","width_mobile":"fit-content","text_alignment_mobile":"left","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0,"mobile-padding-scale":20,"animation_type":"none","animation_delay":250},"blocks":{}}},"block_order":["text_DhxWjD"],"name":"t:names.rich_text","settings":{"container":"page-width","content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","horizontal_alignment_flex_direction_column":"flex-start","column_gap":30,"row_gap":24,"column_gap_mobile":12,"row_gap_mobile":12,"use_color_scheme_in_container":true,"color_scheme":"scheme-2","border":"none","border_width":1,"border_opacity":100,"border_radius":20,"device":"desktop","padding-block-start":40,"padding-block-end":40,"padding-inline-start":50,"padding-inline-end":50,"padding-block-start-mobile":32,"padding-block-end-mobile":32,"padding-inline-start-mobile":20,"padding-inline-end-mobile":20}},"custom_section_AYwNN4":{"type":"custom-section","name":"t:names.marquee","settings":{"container":"page-width--full","content_direction":"row","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","horizontal_alignment_flex_direction_column":"flex-start","column_gap":12,"row_gap":12,"column_gap_mobile":12,"row_gap_mobile":12,"use_color_scheme_in_container":false,"color_scheme":"","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"device":"desktop","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0,"padding-block-start-mobile":0,"padding-block-end-mobile":0,"padding-inline-start-mobile":0,"padding-inline-end-mobile":0}}},"order":["flex_carousel_HzxVGF","custom_liquid_LBDzxX","custom_section_4TcH77","product_tabs_VFRpjk","custom_section_8WifFy","testimonials_parallax_8FqTjk","custom_section_cjGfXN","custom_section_9C4tqY","custom_section_AYwNN4"]}