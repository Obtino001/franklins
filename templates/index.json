on_item_HwPbc9","collection_item_rbbKjE","collection_item_bJ8Fnn","collection_item_UmNVgb","collection_item_ghyBNX","collection_item_GfRqdP","collection_item_XhYTWh","collection_item_4mg9xP","collection_item_QKgdHT"],"name":"t:names.flex_carousel_collections","settings":{"container":"page-width","overflow_content":"edge-shadows","slides_per_view":"auto","columns":4,"column_gap":12,"enable_swipe_on_mobile":false,"swipe_custom_width_column":false,"swipe_column_width":76,"columns_mobile":"2","column_gap_mobile":8,"color_scheme":"scheme-1","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"control_type":"none","control_alignment":"end","device":"mobile","padding-block-start":20,"padding-block-end":20,"padding-block-start-mobile":20,"padding-block-end-mobile":20}},"custom_liquid_LBDzxX":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"{%- comment -%}\n  Franklins hero.\n\n  Konfiguration samlet øverst, så billeder, links og rating kun står ét sted.\n  Billederne ligger i Files (ikke som theme-assets), så de hentes via deres\n  CDN-URL. Shopify CDN respekterer &width= på de URL'er, hvilket er det der\n  gør en rigtig srcset mulig herunder.\n{%- endcomment -%}\n\n{%- liquid\n  assign fr_rating = '4.8'\n  assign fr_rating_suffix = '1000+ faste kunder'\n\n  assign hero_desktop = 'https:\/\/cdn.shopify.com\/s\/files\/1\/0942\/8382\/5500\/files\/Untitled_design_-_2026-08-01T142629.872.jpg?v=1785587205'\n  assign hero_mobile = 'https:\/\/cdn.shopify.com\/s\/files\/1\/0942\/8382\/5500\/files\/Headder_mobil.jpg?v=1784537590'\n\n  assign hero_desktop_widths = '900,1200,1600,2000,2600' | split: ','\n  assign hero_mobile_widths = '480,640,780,960,1170' | split: ','\n\n  comment\n    Lokale-sikre links. routes.collections_url er '\/collections' på primærsproget\n    og fx '\/en\/collections' på et oversat sprog, så stien sættes bare på.\n  endcomment\n  assign url_thca = routes.collections_url | append: '\/thca'\n  assign url_rygegrej = routes.collections_url | append: '\/rygegrej'\n  assign url_cbd = routes.collections_url | append: '\/cbd'\n-%}\n\n<style>\n  .fr-hero {\n    --fr-cream: 251 246 236;\n    --fr-radius: 1.6rem;\n\n    position: relative;\n    display: flex;\n    align-items: center;\n    overflow: hidden;\n    isolation: isolate;\n    margin: 0;\n    min-height: 58rem;\n    border-radius: var(--fr-radius);\n    color: rgb(var(--color-foreground));\n  }\n\n  \/* ---------- Media ---------- *\/\n  .fr-hero__bg { position: absolute; inset: 0; z-index: 0; }\n  .fr-hero__bg img {\n    display: block;\n    width: 100%; height: 100%;\n    object-fit: cover; object-position: center;\n  }\n\n  \/* Cream scrim, heaviest where the text sits *\/\n  .fr-hero__scrim {\n    position: absolute; inset: 0; z-index: 1; pointer-events: none;\n    background: linear-gradient(\n      to bottom,\n      rgb(var(--fr-cream) \/ 0.90) 0%,\n      rgb(var(--fr-cream) \/ 0.66) 42%,\n      rgb(var(--fr-cream) \/ 0.34) 78%,\n      rgb(var(--fr-cream) \/ 0.20) 100%\n    );\n  }\n\n  \/* ---------- Content ---------- *\/\n  .fr-hero__inner {\n    position: relative; z-index: 2;\n    width: 100%;\n    display: flex; flex-direction: column;\n    align-items: center; text-align: center;\n    gap: 2.4rem;\n    padding: 5.6rem 2.4rem;\n  }\n  .fr-hero__inner motion-component { display: block; }\n\n  \/* Rating pill *\/\n  .fr-hero__rating {\n    display: inline-flex; align-items: center; gap: 0.8rem;\n    padding: 0.6rem 1.4rem;\n    border-radius: 99px;\n    background: rgb(255 255 255 \/ 0.85);\n    border: 0.1rem solid rgb(var(--color-foreground) \/ 0.12);\n    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);\n  }\n  .fr-hero__stars { display: inline-flex; gap: 0.3rem; }\n  .fr-hero__star {\n    width: 1.5rem; height: 1.5rem; border-radius: 0.25rem;\n    background: #00b67a;\n    display: inline-flex; align-items: center; justify-content: center;\n  }\n  .fr-hero__star svg { width: 1.1rem; height: 1.1rem; fill: #fff; display: block; }\n  .fr-hero__rating-text {\n    font-family: var(--font-body--family);\n    font-size: 1.25rem; font-weight: 600;\n    color: rgb(var(--color-foreground)); white-space: nowrap;\n  }\n\n  \/* Headline + subtext — theme type tokens *\/\n  .fr-hero__title {\n    margin: 0;\n    font-family: var(--font-heading--family);\n    font-weight: var(--font-heading--weight);\n    font-size: var(--font-size--h1);\n    line-height: var(--font-h1--line-height, 1.12);\n    letter-spacing: var(--font-heading--letter-spacing, -0.01em);\n    max-width: 15ch;\n    text-wrap: balance;\n  }\n  .fr-hero__sub {\n    margin: 0;\n    font-family: var(--font-body--family);\n    font-size: var(--font-size--paragraph);\n    line-height: var(--font-paragraph--line-height, 1.6);\n    color: rgb(var(--color-foreground) \/ 0.72);\n    max-width: 46ch;\n    text-wrap: pretty;\n  }\n\n  \/* Button row — layout only, the theme owns how buttons look.\n     Mobile: primary spans full width, the two secondaries sit side by side. *\/\n  .fr-hero__ctas {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 1.2rem;\n    width: 100%;\n  }\n  .fr-hero__ctas > * { min-width: 0; }\n  .fr-hero__ctas > .btn { width: 100%; }\n  .fr-hero__ctas > *:first-child { grid-column: 1 \/ -1; }\n\n  \/* Trust badges *\/\n  .fr-hero__trust {\n    \/* gap: 0 — spacing lives on the items instead. With a gap, the divider\n       (border-inline-start on the item) sat flush against one neighbour and\n       0.6rem clear of the other. Symmetric padding centres it in the gutter. *\/\n    display: flex; gap: 0;\n    width: 100%; max-width: 42rem;\n    padding: 1.4rem 1.2rem;\n    border-radius: 1.2rem;\n    background: rgb(255 255 255 \/ 0.75);\n    border: 0.1rem solid rgb(var(--color-foreground) \/ 0.12);\n    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);\n  }\n  .fr-hero__trust-item {\n    flex: 1; display: flex; flex-direction: column;\n    align-items: center; gap: 0.6rem; text-align: center;\n    padding-inline: 0.8rem;\n  }\n  .fr-hero__trust-item + .fr-hero__trust-item {\n    border-inline-start: 0.1rem solid rgb(var(--color-foreground) \/ 0.12);\n  }\n  .fr-hero__trust-icon {\n    width: 2.2rem; height: 2.2rem; flex-shrink: 0;\n    border-radius: 50%; background: #48bb78; color: #fff;\n    display: inline-flex; align-items: center; justify-content: center;\n    --icon-stroke-width: 3;\n  }\n  .fr-hero__trust-icon .icon,\n  .fr-hero__trust-icon svg { width: 1.2rem; height: 1.2rem; }\n  .fr-hero__trust-label {\n    font-family: var(--font-body--family);\n    font-size: 1.1rem; font-weight: 500; line-height: 1.3;\n    color: rgb(var(--color-foreground));\n  }\n\n  \/* ---------- Desktop ---------- *\/\n  @media screen and (min-width: 750px) {\n    .fr-hero { min-height: 56rem; border-radius: 2rem; }\n    .fr-hero__scrim {\n      background: linear-gradient(\n        to right,\n        rgb(var(--fr-cream) \/ 0.94) 0%,\n        rgb(var(--fr-cream) \/ 0.78) 34%,\n        rgb(var(--fr-cream) \/ 0.30) 64%,\n        rgb(var(--fr-cream) \/ 0) 100%\n      );\n    }\n    .fr-hero__inner {\n      align-items: flex-start; text-align: left;\n      max-width: 66rem;\n      padding: 7.2rem 6.4rem;\n      gap: 2.8rem;\n    }\n    .fr-hero__ctas {\n      display: flex; flex-wrap: wrap;\n      justify-content: flex-start;\n      width: auto;\n    }\n    .fr-hero__ctas > .btn { width: auto; }\n    .fr-hero__ctas > *:first-child { grid-column: auto; }\n    .fr-hero__sub { max-width: 48ch; }\n    .fr-hero__trust { max-width: 44rem; }\n  }\n<\/style>\n\n<section class=\"fr-hero color-{{ section.settings.color_scheme | default: 'scheme-1' }}\">\n\n  <div class=\"fr-hero__bg\">\n    <picture>\n      {%- comment -%}\n        Rigtig srcset i stedet for én fast fil: telefonen henter ~780px i stedet\n        for hele desktop-billedet. Shopify CDN skalerer på &width= og forhandler\n        selv WebP\/AVIF ud fra Accept-headeren, så formatet er allerede dækket —\n        det var kun størrelsen der manglede.\n      {%- endcomment -%}\n      <source\n        media=\"(min-width: 750px)\"\n        sizes=\"100vw\"\n        srcset=\"\n          {%- for w in hero_desktop_widths -%}\n            {{ hero_desktop }}&width={{ w }} {{ w }}w{% unless forloop.last %}, {% endunless %}\n          {%- endfor -%}\n        \"\n      >\n      <img\n        src=\"{{ hero_mobile }}&width=780\"\n        srcset=\"\n          {%- for w in hero_mobile_widths -%}\n            {{ hero_mobile }}&width={{ w }} {{ w }}w{% unless forloop.last %}, {% endunless %}\n          {%- endfor -%}\n        \"\n        sizes=\"100vw\"\n        alt=\"Franklins – lovligt CBD, THCA og rygegrej\"\n        loading=\"eager\"\n        fetchpriority=\"high\"\n        decoding=\"async\"\n      >\n    <\/picture>\n  <\/div>\n\n  <div class=\"fr-hero__scrim\"><\/div>\n\n  <div class=\"fr-hero__inner\">\n\n    <motion-component data-motion=\"fade-up\" data-motion-delay=\"0\">\n      <div class=\"fr-hero__rating\">\n        <span class=\"fr-hero__stars\" aria-hidden=\"true\">\n          {%- for i in (1..5) -%}\n            <span class=\"fr-hero__star\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n            <\/span>\n          {%- endfor -%}\n        <\/span>\n        <span class=\"fr-hero__rating-text\">{{ fr_rating }}\/5 · {{ fr_rating_suffix }}<\/span>\n      <\/div>\n    <\/motion-component>\n\n    <motion-component data-motion=\"fade-up\" data-motion-delay=\"100\">\n      <h1 class=\"fr-hero__title\">Lovligt CBD, THCA &amp; rygegrej<\/h1>\n    <\/motion-component>\n\n    <motion-component data-motion=\"fade-up\" data-motion-delay=\"200\">\n      <p class=\"fr-hero__sub\">Hurtig levering. Stort udvalg. Ingen kompromiser — uanset om det er dit første køb eller dit hundrede.<\/p>\n    <\/motion-component>\n\n    <motion-component data-motion=\"fade-up\" data-motion-delay=\"300\">\n      <div class=\"fr-hero__ctas\">\n        {% render 'button',\n          label: 'Shop THCA',\n          link: url_thca,\n          style: 'primary',\n          size: 'large',\n          icon: 'arrow-right',\n          icon_style: 'solid',\n          with_wrapper: false\n        %}\n        {% render 'button',\n          label: 'Shop CBD',\n          link: url_cbd,\n          style: 'secondary',\n          size: 'large',\n          with_wrapper: false\n        %}\n        {% render 'button',\n          label: 'Se Rygegrej',\n          link: url_rygegrej,\n          style: 'outline',\n          size: 'large',\n          with_wrapper: false\n        %}\n      <\/div>\n    <\/motion-component>\n\n    <motion-component data-motion=\"fade-up\" data-motion-delay=\"400\">\n      <div class=\"fr-hero__trust\">\n        <div class=\"fr-hero__trust-item\">\n          <span class=\"fr-hero__trust-icon\" aria-hidden=\"true\">{% render 'icon', icon: 'check' %}<\/span>\n          <span class=\"fr-hero__trust-label\">Dag-til-dag levering<\/span>\n        <\/div>\n        <div class=\"fr-hero__trust-item\">\n          <span class=\"fr-hero__trust-icon\" aria-hidden=\"true\">{% render 'icon', icon: 'check' %}<\/span>\n          <span class=\"fr-hero__trust-label\">Fri fragt over 499 kr.<\/span>\n        <\/div>\n        <div class=\"fr-hero__trust-item\">\n          <span class=\"fr-hero__trust-icon\" aria-hidden=\"true\">{% render 'icon', icon: 'check' %}<\/span>\n          <span class=\"fr-hero__trust-label\">Altid diskret pakket<\/span>\n        <\/div>\n      <\/div>\n    <\/motion-component>\n\n  <\/div>\n\n<\/section>","container":"fixed","color_scheme":"scheme-1","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"device":"desktop","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0,"padding-block-start-mobile":0,"padding-block-end-mobile":0,"padding-inline-start-mobile":0,"pa