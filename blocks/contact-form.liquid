{%- liquid
  assign form_id = 'ContactForm-' | append: block.id
  assign show_name = block.settings.show_name
  assign show_email = block.settings.show_email
  assign show_message = block.settings.show_message
  assign custom_fields_first = block.settings.custom_fields_first
  assign email_full_width = block.settings.email_full_width
  assign name_label = block.settings.name_label
  assign email_label = block.settings.email_label
  assign message_label = block.settings.message_label
  assign submit_label = block.settings.submit_label
  if name_label == blank
    assign name_label = 'blocks.contact_form.name' | t
  endif
  if email_label == blank
    assign email_label = 'blocks.contact_form.email' | t
  endif
  if message_label == blank
    assign message_label = 'blocks.contact_form.your_message' | t
  endif
  if submit_label == blank
    assign submit_label = 'blocks.contact_form.send_message' | t
  endif
-%}
<div
  class="contact-form size-style"
  style="{% render 'size-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {% comment %} Contact Form {% endcomment %}
  {%- form 'contact', id: form_id, class: 'w-full' -%}
    {%- if form.posted_successfully? -%}
      <div class="form-status-list" role="status">
        <h3
          class="form-message alert alert--success h6 flex gap-2"
          tabindex="-1"
          autofocus
        >
          {% render 'icon', icon: 'check', size: 'small', class: 'shrink-0' %}
          {{- 'blocks.contact_form.post_success' | t -}}
        </h3>
      </div>
    {%- elsif form.errors -%}
      <div class="form-error alert alert--error">
        <h3
          class="form-message form-message--error h6 flex gap-2"
          role="alert"
          tabindex="-1"
          autofocus
        >
          {% render 'icon', icon: 'warning', size: 'small', class: 'shrink-0' %}
          {{- 'blocks.contact_form.error_heading' | t -}}
        </h3>

        <ul role="list">
          <li>
            <a href="#ContactForm-email" class="reversed-link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
        </ul>
      </div>
    {%- endif -%}

    {% comment %} form fields {% endcomment %}
    <div
      class="contact__fields layout-panel-grid gap-style"
      style="{% render 'layout-panel-style', type: 'grid', columns_md: '2' %}{% render 'gap-style', settings: block.settings %}"
    >
      {%- if custom_fields_first -%}
        {% content_for 'blocks' %}
      {%- endif -%}

      {%- if show_name -%}
      <div class="form-field form-field--name">
        <label class="form-label" for="ContactForm-name-{{ section.id }}">
          {{- name_label -}}
        </label>
        <input
          class="form-control w-full"
          autocomplete="name"
          type="text"
          id="ContactForm-name-{{ section.id }}"
          name="contact[{{ name_label }}]"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        >
      </div>
      {%- endif -%}
      {%- if show_email -%}
      <div class="form-field form-field--email{% if email_full_width %} form-field--full{% endif %}">
        <label class="form-label" for="ContactForm-email-{{ section.id }}">
          {{- email_label -}}
          <span aria-hidden="true">*</span>
        </label>
        <input
          autocomplete="email"
          type="email"
          id="ContactForm-email-{{ section.id }}"
          class="form-control w-full"
          name="contact[email]"
          spellcheck="false"
          autocapitalize="off"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          required
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="ContactForm-email-error-{{ section.id }}"
          {% endif %}
        >
        {%- if form.errors contains 'email' -%}
          <span
            class="form-message form-message--small form-message--error flex gap-2"
            id="ContactForm-email-error-{{ section.id }}"
          >
            {% render 'icon', icon: 'warning', class: 'shrink-0' %}
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </span>
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- unless custom_fields_first -%}
        {% content_for 'blocks' %}
      {%- endunless -%}

      {%- if show_message -%}
      <div class="form-field form-field--full form-field--body">
        <label class="form-label" for="ContactForm-body-{{ section.id }}">
          {{- message_label -}}
        </label>
        <textarea
          rows="5"
          id="ContactForm-body-{{ section.id }}"
          class="form-control form-control--textarea w-full"
          name="contact[{{ message_label }}]"
          placeholder=""
        >
          {{- form.body -}}
        </textarea>
      </div>
      {%- endif -%}

      <div class="contact__button form-footer text-center form-field--full{% if block.settings.submit_full_width %} contact__button--full{% endif %}">
        <button type="submit" class="btn btn--primary btn--large{% unless block.settings.submit_full_width %} btn--icon-solid{% endunless %}{% if block.settings.submit_full_width %} w-full{% endif %}">
          <span class="btn__text">{{ submit_label }}</span>
          {%- unless block.settings.submit_full_width -%}
          <span class="btn__icon">
            <span class="btn__icon-text">{{ submit_label }}</span>
            <span class="btn__icon-icon">
              {% render 'icon', icon: 'caret-right' %}
            </span>
          </span>
          {%- endunless -%}
        </button>
      </div>
    </div>
  {%- endform -%}
</div>
{% stylesheet %}
  .contact-form .contact__button--full {
    width: 100%;
  }
  .contact-form .contact__button--full .btn {
    width: 100%;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:names.contact_form",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.mobile_settings"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Form layout"
    },
    {
      "type": "checkbox",
      "id": "show_name",
      "label": "Show name field",
      "default": true
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "visible_if": "{{ block.settings.show_name }}"
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show email field",
      "default": true
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "visible_if": "{{ block.settings.show_email }}"
    },
    {
      "type": "checkbox",
      "id": "email_full_width",
      "label": "Email full width",
      "default": false,
      "visible_if": "{{ block.settings.show_email }}"
    },
    {
      "type": "checkbox",
      "id": "show_message",
      "label": "Show message field",
      "default": true
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "visible_if": "{{ block.settings.show_message }}"
    },
    {
      "type": "checkbox",
      "id": "custom_fields_first",
      "label": "Custom fields first",
      "default": false
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label"
    },
    {
      "type": "checkbox",
      "id": "submit_full_width",
      "label": "Submit button full width",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "_custom-field"
    }
  ],
  "presets": [
    {
      "name": "t:names.contact_form",
      "blocks": [
        {
          "type": "_custom-field",
          "settings": {
            "field_type": "phone",
            "heading": "Phone Number"
          }
        },
        {
          "type": "_custom-field",
          "settings": {
            "field_type": "text",
            "heading": "Order Number"
          }
        },
        {
          "type": "_custom-field",
          "settings": {
            "field_type": "select",
            "heading": "Country",
            "select_options": "Austria,Viet Nam,Japan",
            "full_width": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
